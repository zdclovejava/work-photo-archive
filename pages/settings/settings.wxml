<wxml>
  <!-- 设置页 -->
  <view class="page">

    <!-- 水印设置分组 -->
    <view class="section-title">水印设置</view>
    <view class="card">
      <view class="cell">
        <text class="cell-label">默认开启时间水印</text>
        <switch checked="{{settings.defaultTimeWatermark}}"
                bindchange="onTimeWatermarkChange" color="#07C160"/>
      </view>
      <view class="cell-divider"></view>
      <view class="cell">
        <text class="cell-label">默认开启地点水印</text>
        <switch checked="{{settings.defaultLocationWatermark}}"
                bindchange="onLocationWatermarkChange" color="#07C160"/>
      </view>
      <view class="cell-divider"></view>
      <view class="cell" bindtap="onPositionTap">
        <text class="cell-label">水印位置</text>
        <text class="cell-value">{{positionText}}</text>
        <text class="cell-arrow">›</text>
      </view>
      <view class="cell-divider"></view>
      <view class="cell cell-vertical">
        <view class="cell-row">
          <text class="cell-label">水印透明度</text>
          <text class="cell-value">{{settings.watermarkOpacity}}%</text>
        </view>
        <slider min="10" max="100" value="{{settings.watermarkOpacity}}"
                activeColor="#07C160" block-size="20"
                bindchange="onOpacityChange"/>
      </view>
    </view>

    <!-- 分类管理分组 -->
    <view class="section-title">分类管理</view>
    <view class="card">
      <!-- 分类标签展示 -->
      <view class="category-tags">
        <view wx:for="{{settings.categories}}" wx:key="id"
              class="cat-tag" style="background:{{item.color}}20; color:{{item.color}}; border:1rpx solid {{item.color}}40;">
          {{item.name}}
          <text class="cat-delete" catchtap="onDeleteCategory" data-id="{{item.id}}">×</text>
        </view>
      </view>
      <view class="cell-divider"></view>
      <view class="cell" bindtap="onAddCategory">
        <text class="cell-label" style="color:#07C160;">+ 添加自定义分类</text>
      </view>
      <view class="cell-divider"></view>
      <view class="cell" bindtap="onSortCategory">
        <text class="cell-label">分类排序</text>
        <text class="cell-value">拖拽排序</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>

    <!-- 存储管理分组 -->
    <view class="section-title">存储管理</view>
    <view class="card">
      <view class="cell">
        <text class="cell-label">缩略图空间</text>
        <text class="cell-value">{{thumbSizeText}}</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width:{{thumbPercent}}%;"></view>
      </view>
      <view class="cell-divider"></view>
      <view class="cell">
        <text class="cell-label">系统相册照片数</text>
        <text class="cell-value" style="color:#07C160;">{{photoCount}} 张</text>
      </view>
      <view class="cell-divider"></view>
      <view class="cell" bindtap="onCleanThumbs">
        <text class="cell-label">清理旧缩略图</text>
        <text class="cell-value">30天前</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>

    <!-- 关于分组 -->
    <view class="section-title">关于</view>
    <view class="card">
      <view class="cell">
        <text class="cell-label">版本</text>
        <text class="cell-value">v1.0.0</text>
      </view>
      <view class="cell-divider"></view>
      <view class="cell" bindtap="onFeedback">
        <text class="cell-label" style="color:#07C160;">意见反馈</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>

    <!-- 底部留白 -->
    <view style="height: 120rpx;"></view>
  </view>
</wxml>
