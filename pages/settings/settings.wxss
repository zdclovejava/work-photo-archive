page {
  background: #EDEDED;
  min-height: 100vh;
}

.page {
  padding-bottom: 120rpx;
  background: #EDEDED;
}

/* 鍒嗙粍鏍囬 */
.section-title {
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 40rpx 12rpx;
}

/* 鍗＄墖 */
.card {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 24rpx;
  padding: 0 32rpx;
  overflow: hidden;
}

/* 鍗曞厓鏍?*/
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.cell-vertical {
  flex-direction: column;
  align-items: stretch;
}

.cell-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cell-label {
  font-size: 30rpx;
  color: #333;
}

.cell-value {
  font-size: 28rpx;
  color: #999;
}

.cell-arrow {
  font-size: 28rpx;
  color: #ccc;
  margin-left: 8rpx;
}

.cell-divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 0 0 0 32rpx;
}

/* 鍒嗙被鏍囩 */
.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 24rpx 0;
}

.cat-tag {
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cat-delete {
  font-size: 28rpx;
  color: inherit;
  opacity: 0.6;
  margin-left: 4rpx;
}

/* 杩涘害鏉?*/
.progress-bar {
  height: 8rpx;
  background: #E8E8E8;
  border-radius: 4rpx;
  margin: 0 0 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #07C160;
  border-radius: 4rpx;
  transition: width 0.3s;
}
