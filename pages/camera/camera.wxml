<wxml>
  <!-- 鎷嶇収椤?-->
  <view class="page">

    <!-- 鍒嗙被閫夋嫨鏍?-->
    <scroll-view class="category-bar" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
      <view class="category-pill {{activeCategory === 'all' ? 'active' : 'inactive'}}"
            bindtap="onCategoryTap" data-id="all">鍏ㄩ儴</view>
      <view wx:for="{{categories}}" wx:key="id"
            class="category-pill {{activeCategory === item.id ? 'active' : 'inactive'}}"
            bindtap="onCategoryTap" data-id="{{item.id}}"
            style="{{activeCategory === item.id ? 'background:' + item.color + ';color:#fff;' : ''}}">
        {{item.name}}
      </view>
      <view class="category-pill inactive" bindtap="onAddCategory">+</view>
    </scroll-view>

    <!-- 鐩告満鍙栨櫙鍖哄煙 -->
    <view class="camera-area">
      <!-- 鏈夌浉鏈烘潈闄愭椂鏄剧ず鐩告満 -->
      <camera wx:if="{{hasCameraAuth}}"
              class="camera-view"
              device-position="{{cameraPosition}}"
              flash="auto"
              binderror="onCameraError"
              bindinitdone="onCameraInitDone">

        <!-- 姘村嵃棰勮娴眰 -->
        <view class="watermark-preview" wx:if="{{showWatermarkPreview}}">
          <view class="watermark-line" wx:if="{{settings.defaultTimeWatermark}}">
            {{currentTime}}
          </view>
          <view class="watermark-line" wx:if="{{settings.defaultLocationWatermark && locationText}}">
            {{locationText}}
          </view>
          <view class="watermark-tag" wx:if="{{activeCategory !== 'all'}}"
                style="background:{{activeCategoryColor}};">
            {{activeCategoryName}}
          </view>
          <view class="watermark-line" wx:if="{{customText}}">
            {{customText}}
          </view>
        </view>

        <!-- 闀滃ご鍊嶇巼鍒囨崲锛堢浉鏈哄垵濮嬪寲鍚庢樉绀猴級 -->
        <view class="zoom-bar" wx:if="{{cameraReady}}">
          <view wx:for="{{zoomOptions}}" wx:key="label"
                class="zoom-btn {{currentZoom === item.value ? 'zoom-active' : 'zoom-inactive'}}"
                bindtap="onZoomTap" data-zoom="{{item.value}}">
            {{item.label}}
          </view>
        </view>

        <!-- 鍙栨櫙杈呭姪绾?-->
        <view class="guide-frame">
          <view class="guide-h"></view>
          <view class="guide-v"></view>
        </view>
      </camera>

      <!-- 鏃犵浉鏈烘潈闄愭椂鐨勫崰浣?-->
      <view class="camera-placeholder" wx:if="{{!hasCameraAuth}}">
        <text class="placeholder-text">璇锋巿鏉冪浉鏈烘潈闄?/text>
        <view class="btn-secondary" bindtap="openSetting">鍘昏缃?/view>
      </view>
    </view>

    <!-- 蹇嵎寮€鍏虫潯 -->
    <view class="switch-bar">
      <view class="switch-item" bindtap="toggleTimeWatermark">
        <view class="switch-icon" style="background:{{settings.defaultTimeWatermark ? '#07C160' : '#ccc'}};">T</view>
        <text class="switch-label">鏃堕棿</text>
        <view class="switch-track {{settings.defaultTimeWatermark ? 'on' : 'off'}}">
          <view class="switch-thumb"></view>
        </view>
      </view>

      <view class="switch-item" bindtap="toggleLocationWatermark">
        <view class="switch-icon" style="background:{{settings.defaultLocationWatermark ? '#07C160' : '#ccc'}};">L</view>
        <text class="switch-label">鍦扮偣</text>
        <view class="switch-track {{settings.defaultLocationWatermark ? 'on' : 'off'}}">
          <view class="switch-thumb"></view>
        </view>
      </view>

      <view class="switch-item" bindtap="toggleCustomText">
        <view class="switch-icon" style="background:{{showCustomText ? '#07C160' : '#ccc'}};">W</view>
        <text class="switch-label">鏂囧瓧</text>
        <view class="switch-track {{showCustomText ? 'on' : 'off'}}">
          <view class="switch-thumb"></view>
        </view>
      </view>
    </view>

    <!-- 鑷畾涔夋枃瀛楄緭鍏ワ紙灞曞紑鏃舵樉绀猴級 -->
    <view class="custom-text-input" wx:if="{{showCustomText}}">
      <input class="text-field" placeholder="杈撳叆鑷畾涔夋按鍗版枃瀛?.."
             value="{{customText}}" bindinput="onCustomTextInput"
             confirm-type="done" bindconfirm="onCustomTextConfirm"/>
    </view>

    <!-- 搴曢儴鎿嶄綔鍖?-->
    <view class="bottom-bar">
      <!-- 鐩稿唽鍏ュ彛 -->
      <view class="album-btn" bindtap="onAlbumTap">
        <view class="album-icon">
          <view class="album-icon-inner"></view>
        </view>
        <text class="bar-label">鐩稿唽</text>
      </view>

      <!-- 鎷嶇収鎸夐挳 -->
      <view class="shutter-btn" bindtap="onTakePhoto">
        <view class="shutter-inner"></view>
      </view>

      <!-- 缈昏浆鎸夐挳 -->
      <view class="flip-btn" bindtap="onFlipTap">
        <text class="flip-icon">鉄?/text>
        <text class="bar-label">缈昏浆</text>
      </view>
    </view>

  </view>
</wxml>
