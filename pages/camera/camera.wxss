page {
  background: #EDEDED;
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #EDEDED;
}

/* 鍒嗙被閫夋嫨鏍?*/
.category-bar {
  white-space: nowrap;
  padding: 12rpx 24rpx;
  background: #EDEDED;
}

.category-pill {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
}

.category-pill.active {
  color: #fff;
}

.category-pill.inactive {
  background: #fff;
  color: #333;
  border: 1rpx solid #ddd;
}

/* 鐩告満鍖哄煙 */
.camera-area {
  flex: 1;
  margin: 0 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background: #1A1A1A;
}

.camera-view {
  width: 100%;
  height: 100%;
}

/* 姘村嵃棰勮娴眰 */
.watermark-preview {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  max-width: 70%;
}

.watermark-line {
  color: rgba(255,255,255,0.9);
  font-size: 22rpx;
  line-height: 1.6;
}

.watermark-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  color: #fff;
  font-size: 20rpx;
  margin-top: 4rpx;
}

/* 鍙栨櫙杈呭姪绾?*/
.guide-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  height: 75%;
  pointer-events: none;
}

.guide-h {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(255,255,255,0.2);
  border-style: dashed;
}

.guide-v {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1rpx;
  background: rgba(255,255,255,0.2);
  border-style: dashed;
}

/* 鏃犳潈闄愬崰浣?*/
.camera-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #1A1A1A;
}

.placeholder-text {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.btn-secondary {
  background: #07C160;
  color: #fff;
  padding: 16rpx 48rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
}

/* 蹇嵎寮€鍏虫潯 */
.switch-bar {
  display: flex;
  padding: 16rpx 48rpx;
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 24rpx;
  justify-content: space-around;
}

.switch-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.switch-label {
  font-size: 26rpx;
  color: #333;
}

.switch-track {
  width: 64rpx;
  height: 32rpx;
  border-radius: 16rpx;
  position: relative;
  transition: background 0.2s;
}

.switch-track.on {
  background: #07C160;
}

.switch-track.off {
  background: #ccc;
}

.switch-thumb {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
  top: 2rpx;
  transition: left 0.2s;
}

.switch-track.on .switch-thumb {
  left: 34rpx;
}

.switch-track.off .switch-thumb {
  left: 2rpx;
}

/* 鑷畾涔夋枃瀛楄緭鍏?*/
.custom-text-input {
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.text-field {
  background: #F7F7F7;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

/* 搴曢儴鎿嶄綔鏍?*/
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 48rpx 48rpx;
  background: #fff;
}

.album-btn, .flip-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.album-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #F7F7F7;
  border: 1rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
}

.album-icon-inner {
  width: 48rpx;
  height: 36rpx;
  border: 3rpx solid #ccc;
  border-radius: 6rpx;
}

.flip-icon {
  font-size: 40rpx;
  color: #999;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-label {
  font-size: 22rpx;
  color: #999;
}

/* 鎷嶇収鎸夐挳 */
.shutter-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7,193,96,0.3);
}

.shutter-inner {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.4);
  background: #fff;
}

.shutter-btn:active .shutter-inner {
  background: #e0e0e0;
}

/* ==================== 闀滃ご鍊嶇巼鍒囨崲 ==================== */

.zoom-bar {
  position: absolute;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 100rpx;
  padding: 6rpx 8rpx;
  gap: 6rpx;
  z-index: 10;
}

.zoom-btn {
  min-width: 72rpx;
  height: 56rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  transition: all 0.2s;
  padding: 0 8rpx;
}

.zoom-btn.zoom-active {
  background: #07C160;
  color: #fff;
  font-weight: 600;
  min-width: 80rpx;
  height: 64rpx;
  box-shadow: 0 0 16rpx rgba(7, 193, 96, 0.5);
}

.zoom-btn.zoom-inactive {
  background: transparent;
}
