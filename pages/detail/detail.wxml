<wxml>
  <!-- 照片详情页 -->
  <view class="page">

    <!-- 照片展示区域 -->
    <view class="photo-area">
      <swiper class="photo-swiper" current="{{currentIndex}}" bindchange="onSwiperChange">
        <swiper-item wx:for="{{photos}}" wx:key="id">
          <image class="photo-full" src="{{item.thumbnailPath || ''}}" mode="aspectFit"
                 bindtap="onPhotoPreview" data-src="{{item.thumbnailPath}}"/>
        </swiper-item>
      </swiper>

      <!-- 左右翻页箭头 -->
      <view class="nav-arrow arrow-left" bindtap="onPrev" wx:if="{{currentIndex > 0}}">‹</view>
      <view class="nav-arrow arrow-right" bindtap="onNext" wx:if="{{currentIndex < photos.length - 1}}">›</view>
    </view>

    <!-- 底部信息面板 -->
    <view class="info-panel">
      <view class="panel-handle"></view>

      <!-- 分类 -->
      <view class="info-row">
        <text class="info-label">分类</text>
        <view class="info-tag" style="background:{{currentPhoto.categoryColor || '#07C160'}};">
          {{currentPhoto.categoryName}}
        </view>
      </view>

      <!-- 时间 -->
      <view class="info-row">
        <text class="info-label">时间</text>
        <text class="info-value">{{currentPhoto.watermark.time || '无'}}</text>
      </view>

      <!-- 地点 -->
      <view class="info-row">
        <text class="info-label">地点</text>
        <text class="info-value">{{currentPhoto.watermark.location || '无'}}</text>
      </view>

      <!-- 水印内容 -->
      <view class="info-row">
        <text class="info-label">水印</text>
        <text class="info-value wm-preview">{{watermarkPreview}}</text>
      </view>

      <!-- 相册状态 -->
      <view class="info-row">
        <text class="info-label">状态</text>
        <view class="status-ok" wx:if="{{currentPhoto.savedToAlbum}}">
          <view class="status-dot"></view>
          <text class="status-text">已保存到系统相册</text>
        </view>
        <text class="status-fail" wx:else>未保存到相册</text>
      </view>

      <!-- 备注 -->
      <view class="info-row">
        <text class="info-label">备注</text>
        <text class="info-value note-text" wx:if="{{currentPhoto.note}}">{{currentPhoto.note}}</text>
        <text class="info-value note-empty" wx:else>暂无备注</text>
      </view>

      <view class="divider"></view>

      <!-- 操作按钮 -->
      <view class="action-row">
        <view class="action-btn action-save" bindtap="onSaveToAlbum">
          <text class="action-btn-text">重新保存到相册</text>
        </view>
        <view class="action-btn action-edit" bindtap="onEditNote">
          <text class="action-btn-text">修改备注</text>
        </view>
        <view class="action-btn action-delete" bindtap="onDelete">
          <text class="action-btn-text" style="color:#FF4D4F;">删除</text>
        </view>
      </view>

    </view>
  </view>
</wxml>
