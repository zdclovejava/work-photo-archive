page {
  background: #1A1A1A;
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #1A1A1A;
}

/* 照片预览区域 */
.preview-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: #1A1A1A;
}

.preview-image {
  width: 100%;
  height: 100%;
}

/* 水印叠加预览 */
.watermark-overlay {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  max-width: 60%;
}

.wm-line {
  color: rgba(255,255,255,0.9);
  font-size: 22rpx;
  line-height: 1.6;
}

.wm-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  color: #fff;
  font-size: 20rpx;
  margin-top: 4rpx;
}

/* 编辑面板 */
.edit-panel {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 16rpx 32rpx 48rpx;
  max-height: 55vh;
  overflow-y: auto;
}

.panel-handle {
  width: 60rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #ddd;
  margin: 0 auto 24rpx;
}

.panel-section {
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

/* 分类选择 */
.category-scroll {
  white-space: nowrap;
}

.cat-pill {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
}

.cat-active {
  color: #fff;
}

.cat-inactive {
  background: #F7F7F7;
  color: #666;
  border: 1rpx solid #ddd;
}

/* 水印开关 */
.watermark-switches {
  display: flex;
  gap: 48rpx;
}

.wm-switch-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.wm-switch-label {
  font-size: 28rpx;
  color: #333;
}

/* 输入框 */
.text-field {
  background: #F7F7F7;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  margin-top: 8rpx;
}

/* 保存按钮 */
.save-btn {
  background: #07C160;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  margin-top: 16rpx;
}

.save-btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

.save-btn:active {
  opacity: 0.85;
}

/* 重拍按钮 */
.retake-btn {
  text-align: center;
  padding: 16rpx 0;
  margin-top: 12rpx;
}

.retake-text {
  color: #07C160;
  font-size: 28rpx;
}
