<wxml>
  <!-- 照片库页 -->
  <view class="page">

    <!-- 导航栏（自定义右侧按钮） -->
    <view class="nav-bar">
      <text class="nav-title">照片库</text>
      <text class="nav-action" bindtap="onSearchTap">搜索</text>
    </view>

    <!-- 分类筛选Tab -->
    <scroll-view class="filter-bar" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
      <view class="filter-pill {{activeFilter === 'all' ? 'filter-active' : 'filter-inactive'}}"
            bindtap="onFilterTap" data-id="all">全部</view>
      <view wx:for="{{categories}}" wx:key="id"
            class="filter-pill {{activeFilter === item.id ? 'filter-active' : 'filter-inactive'}}"
            bindtap="onFilterTap" data-id="{{item.id}}">
        {{item.name}}
      </view>
    </scroll-view>

    <!-- 照片网格 -->
    <scroll-view class="photo-grid-scroll" scroll-y="true" enhanced="true"
                 scroll-into-view="{{scrollIntoView}}"
                 scroll-with-animation="true"
                 bindscroll="onScroll">

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{photoGroups.length === 0}}">
        <text class="empty-icon">📷</text>
        <text class="empty-text">还没有照片</text>
        <text class="empty-hint">点击底部拍照按钮开始存档</text>
      </view>

      <!-- 分组列表 -->
      <view wx:for="{{photoGroups}}" wx:key="date" class="photo-group">
        <!-- 日期标题 -->
        <view class="group-header" id="{{item.groupId}}">
          <text class="group-date">{{item.date}}</text>
          <text class="group-count">{{item.photos.length}}张</text>
        </view>

        <!-- 3列网格 -->
        <view class="photo-grid">
          <view wx:for="{{item.photos}}" wx:for-item="photo" wx:key="id"
                class="photo-card" bindtap="onPhotoTap" data-id="{{photo.id}}">
            <image class="photo-thumb"
                   src="{{photo.thumbnailPath || '/images/thumb-placeholder.png'}}"
                   mode="aspectFill" lazy-load="true"
                   binderror="onThumbError"/>
            <!-- 分类标签 -->
            <view class="photo-tag" wx:if="{{photo.watermark.showCategory}}"
                  style="background:{{photo.categoryColor || '#07C160'}};">
              {{photo.categoryName}}
            </view>
          </view>
        </view>
      </view>

    </scroll-view>

    <!-- 右侧日期索引条 -->
    <view class="date-index-bar" wx:if="{{indexList.length > 1}}"
          catchtouchstart="onIndexTouchStart"
          catchtouchmove="onIndexTouchMove"
          catchtouchend="onIndexTouchEnd">
      <view wx:for="{{indexList}}" wx:key="date"
            class="index-item {{activeIndexDate === item.date ? 'index-active' : ''}}"
            data-date="{{item.date}}"
            catchtap="onIndexTap">
        {{item.label}}
      </view>
    </view>

    <!-- 日期气泡提示 -->
    <view class="date-bubble" wx:if="{{showBubble}}">
      <text class="bubble-text">{{bubbleDate}}</text>
    </view>

    <!-- FAB 拍照按钮 -->
    <view class="fab-btn" bindtap="onFabTap">
      <view class="fab-icon">
        <view class="fab-circle-inner"></view>
      </view>
    </view>

  </view>
</wxml>
