page {
  background-color: #EDEDED;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用工具类 */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 24rpx;
  padding: 24rpx 32rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 0 32rpx;
}

/* 主色按钮 */
.btn-primary {
  background: #07C160;
  color: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  padding: 20rpx 0;
}

.btn-primary:active {
  opacity: 0.85;
}

/* 次按钮 */
.btn-secondary {
  background: #F7F7F7;
  color: #333;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 16rpx 0;
  border: 1rpx solid #ddd;
}

/* 危险按钮 */
.btn-danger {
  background: #F7F7F7;
  color: #FF4D4F;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 16rpx 0;
  border: 1rpx solid #FF4D4F;
}

/* 开关开状态 */
.switch-on {
  background: #07C160;
  border-radius: 20rpx;
  position: relative;
  transition: all 0.2s;
}

/* 分类胶囊 */
.category-pill {
  border-radius: 100rpx;
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  display: inline-block;
}

.category-pill.active {
  background: #07C160;
  color: #fff;
}

.category-pill.inactive {
  background: #fff;
  color: #333;
  border: 1rpx solid #ddd;
}
