{
  "pages": [
    "pages/camera/camera",
    "pages/album/album",
    "pages/settings/settings",
    "pages/preview/preview",
    "pages/detail/detail"
  ],
  "window": {
    "navigationBarBackgroundColor": "#EDEDED",
    "navigationBarTitleText": "工作拍照存档",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#EDEDED",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#07C160",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/camera/camera",
        "text": "拍照",
        "iconPath": "images/tab-camera.png",
        "selectedIconPath": "images/tab-camera-active.png"
      },
      {
        "pagePath": "pages/album/album",
        "text": "照片库",
        "iconPath": "images/tab-album.png",
        "selectedIconPath": "images/tab-album-active.png"
      },
      {
        "pagePath": "pages/settings/settings",
        "text": "设置",
        "iconPath": "images/tab-settings.png",
        "selectedIconPath": "images/tab-settings-active.png"
      }
    ]
  },
  "permission": {
    "scope.camera": {
      "desc": "用于拍摄工作照片"
    },
    "scope.writePhotosAlbum": {
      "desc": "用于将带水印的照片保存到系统相册"
    },
    "scope.userLocation": {
      "desc": "用于获取拍摄地点作为水印"
    }
  },
  "requiredPrivateInfos": [
    "getLocation"
  ],
  "sitemapLocation": "sitemap.json"
}
